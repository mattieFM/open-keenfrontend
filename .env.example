# Optional live contract tests. Use a disposable project only.
KEEN_TEST_PROJECT_ID=
KEEN_TEST_READ_KEY=
KEEN_TEST_WRITE_KEY=
KEEN_TEST_MASTER_KEY=
KEEN_TEST_ACCESS_KEY=
KEEN_TEST_ANALYTICS_HOST=https://api.keen.io/3.0
KEEN_TEST_DASHBOARD_HOST=https://dashboard-service.k-n.io
KEEN_TEST_ENABLE_MUTATIONS=false

# Optional relay. The server binds to 127.0.0.1; publish it only behind a
# hardened HTTPS reverse proxy. Empty RELAY_ALLOWED_ORIGINS denies browsers.
PORT=8787
RELAY_ALLOWED_ORIGINS=https://console.example.com
RELAY_ANALYTICS_UPSTREAM=https://api.keen.io/3.0
RELAY_DASHBOARD_UPSTREAM=https://dashboard-service.k-n.io
RELAY_MAX_REQUEST_BYTES=10500000
RELAY_MAX_RESPONSE_BYTES=150000000
RELAY_TIMEOUT_MS=310000
RELAY_ALLOW_PRIVATE_DNS=false
